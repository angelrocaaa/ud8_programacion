<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pruebafx.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
    <Button onAction="#onHelloButtonClick" text="Hello!" />
   <Button fx:id="pruebaPulsaButton" mnemonicParsing="false" text="Pulsa" textAlignment="CENTER" textFill="RED" textOverrun="WORD_ELLIPSIS">
      <font>
         <Font name="Droid Sans Mono Dotted" size="36.0" />
      </font>
      <effect>
         <DropShadow />
      </effect>
   </Button>
   <Button mnemonicParsing="false" onAction="#resetearButton" text="Resetear" />
   <Label fx:id="contadorLabel" />
    <Button mnemonicParsing="false" onAction="#siguienteClickButton" text="Siguiente" />
</VBox>
